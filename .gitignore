# Root ignore rules. Sub-projects keep their own .gitignore files.

# Secrets and local settings (the .env.example files are committed)
.env
**/.env
**/eval.env

# Databricks bundle state and local tooling
.databricks/
.bundle/

# Python and test caches
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
**/eval-results/

# Large media: attach to a GitHub Release instead. The two demo videos are the exception,
# so the Pages site can play them (docs/demo/index.html).
*.mp4
*.mov
!docs/demo/air-carrier-two-minute-demo.mp4
!docs/demo/air-carrier-full-walkthrough.mp4

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
